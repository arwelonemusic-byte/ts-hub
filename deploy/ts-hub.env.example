# /etc/ts-hub.env — systemd EnvironmentFile for ts-hub.service. Mode 600, root:root.
NODE_ENV=production
DATABASE_URL=postgres://tsweb_hub:<password>@127.0.0.1:5432/ts_hub

# Public base URL — builds the Discord OAuth redirect_uri (<base>/api/auth/callback).
NEXT_PUBLIC_BASE_URL=https://hub.tacticalshift.ru
NEXT_PUBLIC_PLANNER_URL=https://planner.tacticalshift.ru

# Discord app shared with the Training Portal (its redirect list needs the hub's callback too).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# {"<role id>":"<role name>"} — the portal's map (PL, SL, FTL, …).
DISCORD_ROLE_MAP=
# Hub admins, comma-separated: Discord user IDs and/or role names from DISCORD_ROLE_MAP.
HUB_ADMIN_IDS=216926207453691906
HUB_ADMIN_ROLES=

# Mission covers the hub takes from the Workshop (lib/uploads.ts). Outside the code so a deploy keeps them.
HUB_UPLOADS_DIR=/var/lib/ts-hub/uploads

# The shared Tactical Shift login (docs/shared-login.md): the login cookie `ts_auth` is set on the parent domain
# and signed with TS_AUTH_SECRET — the SAME value as in /etc/ts-training-portal.env.
TS_AUTH_SECRET=
AUTH_COOKIE_DOMAIN=tacticalshift.ru
# The Discord app's bot token (same as the portal's): members' roles refresh every 10 minutes.
DISCORD_BOT_TOKEN=
# «Анонс в Дискорд»: the channel games are announced in (#анонсы). The bot above needs View Channel, Send Messages
# and Embed Links there.
DISCORD_ANNOUNCE_CHANNEL_ID=
