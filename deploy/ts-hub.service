# /etc/systemd/system/ts-hub.service — same shape as the other TS web units on the box.
# The box is also the Reforger server, so the CPU/memory caps keep the game ahead of the web app.
[Unit]
Description=TS Hub (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=tsweb
Group=tsweb
WorkingDirectory=/opt/ts-web/ts-hub/web
EnvironmentFile=/etc/ts-hub.env
ExecStart=/usr/bin/node /opt/ts-web/ts-hub/web/node_modules/next/dist/bin/next start -p 3004 -H 127.0.0.1
Restart=on-failure
RestartSec=5

CPUWeight=20
CPUQuota=200%
MemoryMax=2G

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/ts-web/ts-hub/web/.next

[Install]
WantedBy=multi-user.target
