# Copy to .env.local for local dev. Everything is optional: with nothing set the app uses
# a PGlite database in web/.data (set up on first use), mock games, and a dev stand-in viewer.
# The server's values live in /etc/ts-hub.env (template: deploy/ts-hub.env.example).

# PostgreSQL. Unset in dev = PGlite (see db/README.md).
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/ts_hub

# Public base URL — used to build the Discord OAuth redirect_uri.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Discord OAuth app (Developer Portal → OAuth2). Add
#   <NEXT_PUBLIC_BASE_URL>/api/auth/callback
# to the app's redirect list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Tactical Shift guild — login is refused for non-members.
DISCORD_GUILD_ID=
# {"<role id>":"<role name>"} — role names end up in the session. Needs every role slot templates require
# (Rifleman, FTL, Grenadier, Machine Gunner, SL, PL, Aircraft Vehicle, Armoured Crew) and "mission officer".
DISCORD_ROLE_MAP=

# Signs the session cookie (HS256). Any long random string.
SESSION_SECRET=

# Hub admins, comma-separated: Discord user IDs and/or role names from DISCORD_ROLE_MAP.
HUB_ADMIN_IDS=
HUB_ADMIN_ROLES=

# Where replay links and the header's Planner link point.
NEXT_PUBLIC_PLANNER_URL=https://planner.tacticalshift.ru
# The planner plans are drawn in (lib/plans/planner.ts). Defaults to the local planner
# (http://localhost:3000) in dev and NEXT_PUBLIC_PLANNER_URL in production.
# PLANNER_PLANS_URL=
